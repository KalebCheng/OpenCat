# Normalise every text file to LF in the repository, regardless of the platform
# or `core.autocrlf`. This keeps `cargo fmt --check` and the CI diff stable, and
# stops Windows checkouts from producing spurious line-ending churn.

* text=auto eol=lf

# --- Explicit text types ----------------------------------------------------
*.rs      text eol=lf
*.toml    text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.mjs     text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.py      text eol=lf
*.sh      text eol=lf

# --- Windows-only scripts keep CRLF -----------------------------------------
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# --- Binary assets: never diff or convert -----------------------------------
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.icns    binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.otf     binary
*.db      binary
*.sqlite  binary
*.exe     binary
*.dll     binary
*.pdb     binary

# --- Generated files: keep them out of diffs and language stats -------------
pnpm-lock.yaml      linguist-generated=true
Cargo.lock          linguist-generated=true
src-tauri/gen/**    linguist-generated=true
examples/demo.db    linguist-generated=true
